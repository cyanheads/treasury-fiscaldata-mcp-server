{
  "name": "treasury-fiscaldata-mcp-server",
  "version": "0.1.7",
  "description": "Query US Treasury national debt, interest rates, exchange rates, and fiscal datasets via MCP.",
  "author": {
    "name": "cyanheads"
  },
  "homepage": "https://github.com/cyanheads/treasury-fiscaldata-mcp-server#readme",
  "repository": "https://github.com/cyanheads/treasury-fiscaldata-mcp-server",
  "license": "Apache-2.0",
  "mcpServers": {
    "treasury-fiscaldata-mcp-server": {
      "command": "npx",
      "args": ["-y", "@cyanheads/treasury-fiscaldata-mcp-server"],
      "env": {
        "MCP_TRANSPORT_TYPE": "stdio",
        "CANVAS_PROVIDER_TYPE": "duckdb"
      }
    }
  }
}
