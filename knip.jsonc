{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": ["src/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts"],
  "project": ["src/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts"],
  // Separately installed registry CLI; not an npm dependency.
  "ignoreBinaries": ["mcp-publisher"],
  // Framework linter script's fallback when run inside the framework itself.
  "ignoreUnresolved": ["../src/linter/validate.js"],
  "ignoreDependencies": [
    // Loaded by the framework's logging transport.
    "pino-pretty",
    // Invoked through build/devcheck subprocesses and Bun's install.security config.
    "tsx",
    "@socketsecurity/bun-security-scanner"
  ]
}
